# PantryPal — local environment variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env is gitignored. Never commit real passwords.

# ---------- SQL Server passwords (required) ----------
# Used as the SA password for each local SQL Server container
# and passed to the matching service as DB_PASSWORD.
# SQL Server rejects weak passwords: at least 8 characters,
# with upper case, lower case, a digit and a symbol.
PANTRY_DB_PASSWORD=
CATALOG_DB_PASSWORD=

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Open Food Facts (catalog-service) ----------
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT_SECONDS=5

# ---------- Reference: variables each service reads ----------
# docker-compose.yml sets these for you. Only set them yourself
# if you run a service outside Docker (e.g. uvicorn directly).
# DB_HOST=localhost
# DB_PORT=1433            # pantry-db; use 1434 for catalog-db
# DB_NAME=pantry          # or catalog
# DB_USER=sa
# DB_PASSWORD=
# CORS_ORIGINS=http://localhost:8080