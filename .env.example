# PantryPal — local environment variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env is gitignored. Never commit real passwords.

# ---------- SQL Server passwords (required) ----------
# SQL Server rejects weak passwords: at least 8 characters,
# with upper case, lower case, a digit and a symbol.
# Generate one with:  echo 'Pp1!'"$(openssl rand -base64 18 | tr -d '/+=')"
# Use four different passwords.

# Admin (sa) password of each local SQL Server container.
# Used only by the database container and its one-shot init job,
# never by the APIs.
PANTRY_DB_PASSWORD=
CATALOG_DB_PASSWORD=

# Password of each service's own login (pantry_user / catalog_user).
# The init job creates the login; the API connects with it.
PANTRY_DB_APP_PASSWORD=
CATALOG_DB_APP_PASSWORD=

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Open Food Facts (catalog-service) ----------
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT_SECONDS=5

# ---------- Reference: variables each service reads ----------
# docker-compose.yml sets these for you. Only set them yourself
# if you run a service outside Docker (e.g. uvicorn directly).
# DB_HOST=localhost
# DB_PORT=1433            # pantry-db; use 1434 for catalog-db
# DB_NAME=pantry_db       # or catalog_db
# DB_USER=pantry_user     # or catalog_user (never sa)
# DB_PASSWORD=            # the matching *_DB_APP_PASSWORD
# CORS_ORIGINS=http://localhost:8080